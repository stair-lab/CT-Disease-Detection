{
  "experiment_name": "comorbidities_detection_hcc18",
  "description": "Multi-task learning for comorbidity detection from CT scans with HCC18 Only",
  "binary_biomarkers": [
    {
      "name": "HCC18",
      "description": "HCC code 18",
      "positive_class": "PRESENT"
    }
  ],
  "multiclass_biomarkers": [],
  "continuous_biomarkers": [],
  "preprocessing": {
    "image_size": 256,
    "normalize_images": true,
    "convert_to_rgb": true
  },
  "training": {
    "class_weighting": true,
    "balanced_sampling": true
  },
  "validation": {
    "threshold_optimization": true,
    "optimization_metric": "f1_score",
    "per_biomarker_thresholds": true,
    "threshold_search_range": [
      0.1,
      0.9
    ],
    "threshold_search_steps": 9,
    "fallback_threshold": 0.5,
    "metrics": [
      "auroc",
      "accuracy",
      "sensitivity",
      "specificity",
      "f1_score",
      "precision",
      "recall"
    ],
    "regression_metrics": [
      "mse",
      "mae",
      "r2_score"
    ]
  }
}